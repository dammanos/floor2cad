NODE_ENV=development
PORT=5001
CLIENT_PORT=3000
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_FILE_SIZE=50000000
# Comma-separated list of allowed CORS origins. Defaults to http://localhost:${CLIENT_PORT}.
CORS_ORIGINS=http://localhost:3000
# Rate limiting (requests per window) for /api/upload and /api/convert.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# How long to keep files in UPLOAD_DIR / OUTPUT_DIR (minutes). 0 disables cleanup.
FILE_RETENTION_MINUTES=120
FILE_RETENTION_INTERVAL_MINUTES=15
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_MS=12000
ML_OCR_ENABLED=false
ML_OCR_LANG=en
ML_OCR_BACKEND=rapidocr
ML_SYMBOLS_ENABLED=false
ML_SYMBOL_MODEL_PATH=./ml_service/models/floorplan_symbols.pt
ML_SEGMENTATION_ENABLED=false
ML_SEGMENTATION_MODEL=nvidia/segformer-b0-finetuned-ade-512-512
